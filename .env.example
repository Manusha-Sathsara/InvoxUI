# WSO2 Asgardeo Authentication Settings
# Replace with your actual Client ID from Asgardeo Console (SPA Application)
VITE_ASGARDEO_CLIENT_ID=your_asgardeo_client_id_here

# Replace with your Asgardeo Organization Base URL (e.g., https://api.asgardeo.io/t/your_org_name)
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/your_org_name

# Redirect URLs (must match configured Authorized Redirect URLs in Asgardeo)
VITE_ASGARDEO_SIGN_IN_REDIRECT_URL=http://localhost:5173
VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL=http://localhost:5173
